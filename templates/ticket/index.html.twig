{% extends 'base.html.twig' %}

{% block title %}Tickets · {{ parent() }}{% endblock %}

{% block body %}
    <h1 class="text-2xl font-bold">Les tickets</h1>
    <a href="{{ path('ticket_new') }}"
       class="mt-4 inline-block rounded-lg bg-blue-600 px-4 py-2 font-semibold text-white">Déclarer un incident</a>
    <ul class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
        {% for ticket in tickets %}
            <li class="rounded-xl border p-4">
                {{ include('ticket/_ticket.html.twig') }}
            </li>
        {% else %}
            <li class="text-gray-500">Aucun ticket.</li>
        {% endfor %}
    </ul>
{% endblock %}
