<a href="{{ path('ticket_show', {id: ticket.id}) }}"
   class="font-semibold">{{ ticket.titre }}</a>
{% include 'ticket/_priorite.html.twig'
    with { priorite: ticket.priorite.value } %}
<p class="mt-2 text-sm text-gray-500">
    {{ ticket.categorie.nom }} · <time>{{ ticket.creeLe|date('d/m/Y H:i') }}</time>
</p>
