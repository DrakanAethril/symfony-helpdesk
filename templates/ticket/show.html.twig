{% extends 'base.html.twig' %}

{% block title %}{{ ticket.titre }} · {{ parent() }}{% endblock %}

{% block body %}
    <h1>{{ ticket.titre }}</h1>
    <p>Priorité : {{ ticket.priorite|upper }}</p>
    <p>Créé le {{ ticket.creeLe|date('d/m/Y') }}</p>
    <p>{{ ticket.description }}</p>
    <a href="{{ path('ticket_index') }}">Retour</a>
{% endblock %}
