{% extends 'base.html.twig' %}

{% block title %}{{ ticket.titre }} · {{ parent() }}{% endblock %}

{% block body %}
    <h1 class="text-2xl font-bold">{{ ticket.titre }}</h1>
    <p class="text-sm text-gray-500">
        Catégorie : {{ ticket.categorie.nom }}</p>
    {% include 'ticket/_priorite.html.twig' with { priorite: ticket.priorite.value } %}
    <p class="mt-4">{{ ticket.description }}</p>
    <dl class="mt-4">
        <dt class="font-medium">Statut</dt>
        <dd>{{ ticket.statut.value }}</dd>
        <dt class="font-medium">Créé le</dt>
        <dd>{{ ticket.creeLe|date('d/m/Y H:i') }}</dd>
        <dt class="font-medium">Échéance</dt>
        <dd>
            {{ echeance|date('d/m/Y H:i') }}
            {% if enRetard %}
                <span class="rounded-full bg-red-100 px-3 py-1
                    text-sm font-medium text-red-800">en retard</span>
            {% endif %}
        </dd>
        <dt class="font-medium">Auteur</dt>
        <dd>{{ ticket.auteur.prenom }} {{ ticket.auteur.nom }}</dd>
        <dt class="font-medium">Technicien</dt>
        <dd>{{ ticket.technicien ? ticket.technicien.prenom ~ ' ' ~ ticket.technicien.nom : 'Non assigné' }}</dd>
        {% if ticket.resoluLe %}
            <dt class="font-medium">Résolu le</dt>
            <dd>{{ ticket.resoluLe|date('d/m/Y H:i') }}</dd>
        {% endif %}
    </dl>

    <h2 class="text-lg font-semibold mt-6">Matériels concernés</h2>
    <ul class="mt-4 list-disc pl-6">
    {% for m in ticket.materiels %}
        <li>{{ m.numeroInventaire }} · {{ m.type }} · {{ m.site }}</li>
    {% else %}
        <li class="text-gray-500">
          Aucun matériel concerné.</li>
    {% endfor %}
    </ul>
    <p class="mt-6 flex items-center gap-4">
        {% if is_granted('TICKET_EDIT', ticket) %}
            <a href="{{ path('ticket_edit', {id: ticket.id}) }}"
               class="rounded-lg bg-blue-600 px-4 py-2
                      font-semibold text-white">
                Modifier</a>
        {% endif %}
        <a href="{{ path('ticket_index') }}" class="text-blue-700 underline">Retour aux tickets</a>
    </p>
{% endblock %}
