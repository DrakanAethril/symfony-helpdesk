{% extends 'base.html.twig' %}

{% block body %}
    <h1 class="text-2xl font-bold">Helpdesk de Norbelle</h1>
    <p class="mt-2">Déclarer et suivre les incidents.</p>
    {% if app.user %}
        <a href="{{ path('ticket_index') }}"
           class="mt-4 inline-block rounded-lg bg-blue-600 px-4 py-2 font-semibold text-white">Voir les tickets</a>

        <h2 class="text-lg font-semibold mt-6">Tickets ouverts, les plus urgents d'abord</h2>
        <ul class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
            {% for ticket in tickets|filter(t => is_granted('TICKET_VIEW', t)) %}
                <li class="rounded-xl border p-4">
                    {{ include('ticket/_ticket.html.twig') }}
                </li>
            {% else %}
                <li class="text-gray-500">Aucun ticket ouvert.</li>
            {% endfor %}
        </ul>
    {% else %}
        <a href="{{ path('app_login') }}"
           class="mt-4 inline-block rounded-lg bg-blue-600 px-4 py-2 font-semibold text-white">Se connecter</a>
    {% endif %}
{% endblock %}
